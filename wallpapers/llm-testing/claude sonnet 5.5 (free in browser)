#!/bin/bash
# =============================================================================
# postinstall.sh - Fedora KDE Plasma (Fedora 41+, Plasma 6) post-install tool
#
# Launch with:
#   curl -sO https://raw.githubusercontent.com/bitflipkickflip/fedora_postinstall/main/postinstall.sh && bash postinstall.sh
#
# Notes:
#   * Runs as a NORMAL user. sudo is used only on individual commands.
#   * "set -e" is intentionally NOT enabled: a failing module must not abort the
#     rest of the run. Failures are tracked and summarised at the end.
#   * -u: treat unset variables as errors. pipefail: a pipeline fails if any
#     stage fails.
# =============================================================================

set -u
set -o pipefail

# =============================================================================
# SECTION 1: CONSTANTS, DISPLAY & LOGGING
# =============================================================================

readonly TTY_DEV="/dev/tty"
readonly MENU_WIDTH=64
readonly MENU_TITLE="FEDORA POST-INSTALLATION CONFIGURATOR"

# Resolve our own absolute path now (used for self-deletion at the end).
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || true)"
if [[ -z "$SCRIPT_PATH" ]]; then
    SCRIPT_PATH="${BASH_SOURCE[0]}"
fi
readonly SCRIPT_PATH

# Colors: only emit escape codes when stdout is a terminal, so no stray
# escape sequences ever end up in logs or pipes.
if [[ -t 1 ]]; then
    readonly C_RED=$'\033[31m'
    readonly C_GREEN=$'\033[32m'
    readonly C_YELLOW=$'\033[33m'
    readonly C_BLUE=$'\033[34m'
    readonly C_RESET=$'\033[0m'
else
    readonly C_RED=""
    readonly C_GREEN=""
    readonly C_YELLOW=""
    readonly C_BLUE=""
    readonly C_RESET=""
fi

# Each logger prints the color, the message, then ALWAYS resets the color.
log_info()    { printf '%s[INFO]    %s%s\n' "$C_BLUE" "$*" "$C_RESET"; }
log_success() { printf '%s[SUCCESS] %s%s\n' "$C_GREEN" "$*" "$C_RESET"; }
log_warn()    { printf '%s[WARNING] %s%s\n' "$C_YELLOW" "$*" "$C_RESET"; }

# =============================================================================
# SECTION 2: STATE
# =============================================================================

# Ordered list of module keys (menu order == numbering, 1..14).
readonly -a MODULE_KEYS=(
    wallpaper
    upgrade nvidia
    brave rmfirefox
    steam prism jagex
    discord vlc kdenlive
    sublime orca
    debloat
)

# Execution order (differs from menu order on purpose, see Section 5 of spec).
readonly -a RUN_ORDER=(
    debloat
    brave rmfirefox
    nvidia
    steam prism jagex
    discord vlc kdenlive
    sublime orca
    wallpaper
    upgrade
)

declare -rA LABEL=(
    [wallpaper]="Wallpaper Setup"
    [upgrade]="System Upgrade"
    [nvidia]="Install NVIDIA Drivers"
    [brave]="Install Brave"
    [rmfirefox]="Remove Firefox"
    [steam]="Install Steam"
    [prism]="Install Prism Launcher"
    [jagex]="Install Jagex Launcher"
    [discord]="Install Discord"
    [vlc]="Install VLC"
    [kdenlive]="Install Kdenlive"
    [sublime]="Replace KWrite with Sublime Text"
    [orca]="Install OrcaSlicer"
    [debloat]="Remove KDE Bloat"
)

declare -rA CATEGORY=(
    [wallpaper]="Appearance"
    [upgrade]="System"
    [nvidia]="System"
    [brave]="Browsers"
    [rmfirefox]="Browsers"
    [steam]="Gaming"
    [prism]="Gaming"
    [jagex]="Gaming"
    [discord]="Communication & Media"
    [vlc]="Communication & Media"
    [kdenlive]="Communication & Media"
    [sublime]="Productivity & Creative"
    [orca]="Productivity & Creative"
    [debloat]="Debloat"
)

# Option state. Booleans: 1 = ON, 0 = OFF.
# Wallpaper: 1 = 2560x1440, 2 = 3440x1440, 3 = skip.
declare -A OPT=(
    [wallpaper]=1
    [upgrade]=1
    [nvidia]=0
    [brave]=1
    [rmfirefox]=1
    [steam]=1
    [prism]=1
    [jagex]=1
    [discord]=1
    [vlc]=1
    [kdenlive]=1
    [sublime]=1
    [orca]=1
    [debloat]=1
)

# Runtime tracking.
declare -A MODULE_FAILED=()
declare -a FAILED_MODULES=()
STEP_FAILED=0
KEEPALIVE_PID=""
RPMFUSION_STATE="unset"   # unset | ok | failed
FLATHUB_STATE="unset"     # unset | ok | failed
DNF_PLUGINS_STATE="unset" # unset | ok | failed

# URLs and package lists.
readonly BRAVE_REPO_URL="https://brave-browser-rpm-release.s3.brave.com/brave-browser.repo"
readonly SUBLIME_KEY_URL="https://download.sublimetext.com/sublimehq-rpm-pub.gpg"
readonly SUBLIME_REPO_URL="https://download.sublimetext.com/rpm/stable/x86_64/sublime-text.repo"
readonly JAGEX_URL="https://rs-launcher-updates.runescape.com/production/linux/x64/latest/jagex-launcher-beta-linux-x86_64.AppImage"
readonly FLATHUB_URL="https://dl.flathub.org/repo/flathub.flatpakrepo"
readonly WALLPAPER_BASE_URL="https://raw.githubusercontent.com/bitflipkickflip/fedora_postinstall/main/wallpapers"
readonly WALLPAPER_STD="Fedora_GrayBlue_Penguin_2560_1440.png"
readonly WALLPAPER_UW="Fedora_GrayBlue_Penguin_3440_1440.png"

readonly -a BLOAT_PKGS=(
    kontact kmail korganizer akregator kaddressbook kcontacts
    kaccounts-integration kaccounts-providers akonadi-server
    akonadi-contacts akonadi-calendar kdepim-addons akonadiconsole
    itinerary elisa-player dragon kamoso kate khelpcenter kfind
    konqueror neochat kpatience kmines ksudoku kinfocenter kpat kmahjongg
)

# =============================================================================
# SECTION 3: HELPERS (cleanup, sudo keepalive, command runner)
# =============================================================================

# Stop the sudo keepalive helper (if any). Runs on every exit path.
cleanup() {
    if [[ -n "$KEEPALIVE_PID" ]]; then
        kill "$KEEPALIVE_PID" 2>/dev/null
        wait "$KEEPALIVE_PID" 2>/dev/null
        KEEPALIVE_PID=""
    fi
}
trap cleanup EXIT
trap 'log_warn "Interrupted."; exit 130' INT
trap 'log_warn "Terminated."; exit 143' TERM

# Ask for the sudo password ONCE, then refresh the credential in the
# background until the script exits.
acquire_sudo() {
    local parent_pid=$$
    log_info "Administrator rights are required. Enter your sudo password once."
    if ! sudo -v; then
        log_warn "Could not obtain sudo credentials. Aborting."
        exit 1
    fi
    (
        spid=""
        # On TERM: stop the pending sleep and leave immediately.
        trap '[[ -n "$spid" ]] && kill "$spid" 2>/dev/null; exit 0' TERM
        # Loop ends by itself if the parent script is gone (no orphan).
        while kill -0 "$parent_pid" 2>/dev/null; do
            # -n: never prompt; -v: only refresh the credential timestamp.
            sudo -n -v 2>/dev/null
            sleep 30 &
            spid=$!
            wait "$spid"
        done
    ) &
    KEEPALIVE_PID=$!
}

# Run a command; on failure warn and flag the current module as failed.
# Returns the command's exit status so callers can bail out if needed.
try() {
    local rc
    "$@"
    rc=$?
    if (( rc != 0 )); then
        STEP_FAILED=1
        log_warn "Command failed (exit ${rc}): $*"
    fi
    return "$rc"
}

# True if an RPM package with this exact name is installed.
pkg_installed() {
    rpm -q "$1" >/dev/null 2>&1
}

# True if the option for a module is selected.
is_selected() {
    local key="$1"
    if [[ "$key" == "wallpaper" ]]; then
        [[ "${OPT[wallpaper]}" != "3" ]]
    else
        [[ "${OPT[$key]}" == "1" ]]
    fi
}

# =============================================================================
# SECTION 4: MENU
# =============================================================================

# Print a repeated character MENU_WIDTH times.
rule_line() {
    local ch="$1" line
    printf -v line '%*s' "$MENU_WIDTH" ''
    printf '%s\n' "${line// /$ch}"
}

# Print the status text for a module (status is the last column, so invisible
# color codes can never break the alignment).
print_status() {
    local key="$1"
    if [[ "$key" == "wallpaper" ]]; then
        case "${OPT[wallpaper]}" in
            1) printf '%sResolution 2560x1440%s\n' "$C_GREEN" "$C_RESET" ;;
            2) printf '%sResolution 3440x1440%s\n' "$C_GREEN" "$C_RESET" ;;
            *) printf '%sDisabled%s\n' "$C_RED" "$C_RESET" ;;
        esac
    elif [[ "${OPT[$key]}" == "1" ]]; then
        printf '%sON%s\n' "$C_GREEN" "$C_RESET"
    else
        printf '%sOFF%s\n' "$C_RED" "$C_RESET"
    fi
}

draw_menu() {
    local i key cat last_cat="" pad
    if [[ -t 1 ]]; then
        # Clear screen and move cursor home.
        printf '\033[2J\033[H'
    fi
    pad=$(( (MENU_WIDTH - ${#MENU_TITLE}) / 2 ))
    rule_line "="
    printf '%*s%s\n' "$pad" '' "$MENU_TITLE"
    rule_line "="
    printf '%-41s%s\n' ' Module / Option' 'Current Status'
    rule_line "-"

    for i in "${!MODULE_KEYS[@]}"; do
        key="${MODULE_KEYS[$i]}"
        cat="${CATEGORY[$key]}"
        if [[ "$cat" != "$last_cat" ]]; then
            printf '\n  >> %s\n' "$cat"
            last_cat="$cat"
        fi
        printf ' %2d) %-33s : ' "$(( i + 1 ))" "${LABEL[$key]}"
        print_status "$key"
    done

    printf '\n'
    rule_line "-"
    printf ' Wallpaper values:\n'
    printf '   1 = Standard 1440p  (2560x1440)\n'
    printf '   2 = Ultrawide 1440p (3440x1440)\n'
    printf '   3 = Skip wallpaper setup\n'
    rule_line "-"
    printf ' Enter a module number to toggle it.\n'
    printf ' Type "run" or "r" to execute, "quit" or "q" to abort.\n'
    rule_line "="
}

# Normalise user input: strip CRs, trim whitespace, lowercase.
normalize_input() {
    local s="$1"
    s="${s//$'\r'/}"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "${s,,}"
}

# Sub-prompt for the wallpaper multi-choice option.
prompt_wallpaper() {
    local ans
    printf 'Wallpaper: 1 = 2560x1440, 2 = 3440x1440, 3 = Skip : '
    if ! IFS= read -r ans < "$TTY_DEV"; then
        return 0
    fi
    ans="$(normalize_input "$ans")"
    case "$ans" in
        1|2|3) OPT[wallpaper]="$ans" ;;
        *) : ;; # invalid: ignore silently
    esac
}

menu_loop() {
    local raw choice idx key
    while true; do
        draw_menu
        # EOF on the terminal is treated as quit.
        if ! IFS= read -r -p "set > " raw < "$TTY_DEV"; then
            printf '\n'
            log_info "No input available. Aborting; nothing was changed."
            exit 0
        fi
        choice="$(normalize_input "$raw")"
        case "$choice" in
            quit|q)
                log_info "Aborted by user. Nothing was changed."
                exit 0
                ;;
            run|r)
                break
                ;;
        esac
        if [[ "$choice" =~ ^[0-9]{1,3}$ ]]; then
            # 10# forces base 10 so inputs like "08" are not read as octal.
            idx=$(( 10#$choice ))
            if (( idx >= 1 && idx <= ${#MODULE_KEYS[@]} )); then
                key="${MODULE_KEYS[idx-1]}"
                if [[ "$key" == "wallpaper" ]]; then
                    prompt_wallpaper
                elif [[ "${OPT[$key]}" == "1" ]]; then
                    OPT[$key]=0
                else
                    OPT[$key]=1
                fi
            fi
        fi
        # Anything else: silently ignored, menu redraws.
    done
}

# =============================================================================
# SECTION 5: EXECUTION MODULES
# =============================================================================

# ---- Shared setup helpers (lazy and idempotent) -----------------------------

# dnf5 'config-manager' lives in the dnf5-plugins package.
ensure_dnf_plugins() {
    case "$DNF_PLUGINS_STATE" in
        ok) return 0 ;;
        failed) return 1 ;;
    esac
    if try sudo dnf install -y dnf5-plugins; then
        DNF_PLUGINS_STATE="ok"
        return 0
    fi
    DNF_PLUGINS_STATE="failed"
    return 1
}

# Configure RPM Fusion free + nonfree exactly once per run.
ensure_rpmfusion() {
    local ver
    local -a missing=()
    case "$RPMFUSION_STATE" in
        ok) return 0 ;;
        failed) return 1 ;;
    esac

    # Fedora release number detected at runtime (never hardcoded).
    ver="$(rpm -E %fedora 2>/dev/null)"
    if [[ ! "$ver" =~ ^[0-9]+$ ]]; then
        log_warn "Could not detect the Fedora release number."
        RPMFUSION_STATE="failed"
        return 1
    fi

    if ! pkg_installed rpmfusion-free-release; then
        missing+=("https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${ver}.noarch.rpm")
    fi
    if ! pkg_installed rpmfusion-nonfree-release; then
        missing+=("https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${ver}.noarch.rpm")
    fi

    if (( ${#missing[@]} > 0 )); then
        log_info "Configuring RPM Fusion (Fedora ${ver})..."
        if ! try sudo dnf install -y "${missing[@]}"; then
            RPMFUSION_STATE="failed"
            return 1
        fi
    fi
    RPMFUSION_STATE="ok"
    return 0
}

# Flatpak installed + Flathub remote at system scope, once per run.
ensure_flathub() {
    case "$FLATHUB_STATE" in
        ok) return 0 ;;
        failed) return 1 ;;
    esac
    if ! command -v flatpak >/dev/null 2>&1; then
        if ! try sudo dnf install -y flatpak; then
            FLATHUB_STATE="failed"
            return 1
        fi
    fi
    # --if-not-exists makes this safe to re-run.
    if ! try sudo flatpak remote-add --system --if-not-exists flathub "$FLATHUB_URL"; then
        FLATHUB_STATE="failed"
        return 1
    fi
    # Make sure the remote is enabled (harmless if it already is).
    sudo flatpak remote-modify --system --enable flathub >/dev/null 2>&1 || true
    FLATHUB_STATE="ok"
    return 0
}

# Install a Flatpak app system-wide from Flathub, non-interactively.
flatpak_install() {
    local app="$1"
    ensure_flathub || return 1
    if flatpak info --system "$app" >/dev/null 2>&1; then
        log_info "${app} is already installed."
        return 0
    fi
    # -y: assume yes; --noninteractive: never prompt.
    try sudo flatpak install --system -y --noninteractive flathub "$app"
}

# ---- Category A: Appearance -------------------------------------------------

mod_wallpaper() {
    local file dir dest uri qdbus_bin c js_wall js_panel have_session=0
    case "${OPT[wallpaper]}" in
        1) file="$WALLPAPER_STD" ;;
        2) file="$WALLPAPER_UW" ;;
        *) return 0 ;;
    esac

    dir="${HOME}/.local/share/wallpapers"
    mkdir -p -- "$dir" || return 1
    dest="${dir}/${file}"

    # -f: fail on HTTP errors, -s: silent, -S: still show errors,
    # -L: follow redirects.
    if ! try curl -fsSL -o "$dest" "${WALLPAPER_BASE_URL}/${file}"; then
        rm -f -- "$dest"
        return 1
    fi

    # The path is embedded in a JS string below; refuse unsafe characters.
    case "$dest" in
        *\"*|*\\*|*\'*)
            log_warn "Wallpaper path contains unsupported characters: ${dest}"
            return 1
            ;;
    esac
    uri="file://${dest}"

    # Desktop wallpaper on every desktop/screen via the live plasma shell.
    qdbus_bin=""
    for c in qdbus6 qdbus-qt6; do
        if command -v "$c" >/dev/null 2>&1; then
            qdbus_bin="$c"
            break
        fi
    done
    if [[ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]]; then
        have_session=1
    fi

    if (( have_session )) && [[ -n "$qdbus_bin" ]]; then
        js_wall="var ds = desktops(); for (var i = 0; i < ds.length; i++) { var d = ds[i]; d.wallpaperPlugin = 'org.kde.image'; d.currentConfigGroup = ['Wallpaper', 'org.kde.image', 'General']; d.writeConfig('Image', '${uri}'); }"
        try "$qdbus_bin" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js_wall"

        # Make all panels non-floating.
        js_panel="var ps = panels(); for (var j = 0; j < ps.length; j++) { ps[j].floating = false; }"
        try "$qdbus_bin" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js_panel"
    else
        log_warn "No Plasma session / qdbus6 found; skipping live desktop wallpaper and panel changes."
        STEP_FAILED=1
    fi

    # Lock screen wallpaper (KDE 6 config tool).
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        try kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image
        try kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "$uri"
        try kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "$uri"
    else
        log_warn "kwriteconfig6 not found; lock screen wallpaper not set."
        STEP_FAILED=1
    fi

    # Restart plasmashell so the changes show immediately.
    if (( have_session )); then
        kquitapp6 plasmashell >/dev/null 2>&1
        sleep 2
        # setsid: new session, so plasmashell is detached from this script;
        # --replace: take over from any instance still running;
        # trailing & + disown: return control and never wait on it.
        setsid plasmashell --replace >/dev/null 2>&1 < /dev/null &
        disown
        sleep 2
    fi

    [[ "$STEP_FAILED" -eq 0 ]]
}

# ---- Category B: System -----------------------------------------------------

mod_upgrade() {
    try sudo dnf makecache || return 1
    # --refresh: force fresh metadata; -y: assume yes (non-interactive).
    try sudo dnf upgrade --refresh -y || return 1
    try sudo dnf autoremove -y
}

mod_nvidia() {
    ensure_rpmfusion || return 1
    ensure_dnf_plugins || return 1
    # dnf5 syntax for toggling an existing repository.
    try sudo dnf config-manager setopt rpmfusion-nonfree-nvidia-driver.enabled=1 || return 1
    # akmod-nvidia builds the kernel module; the cuda package is the userspace driver.
    try sudo dnf install -y akmod-nvidia xorg-x11-drv-nvidia-cuda
}

# ---- Category C: Browsers ---------------------------------------------------

mod_brave() {
    ensure_dnf_plugins || return 1
    # dnf5 syntax; --overwrite makes re-runs safe if the .repo already exists.
    try sudo dnf config-manager addrepo --from-repofile="$BRAVE_REPO_URL" --overwrite || return 1
    try sudo dnf install -y brave-browser
}

mod_rmfirefox() {
    # Never leave the user without a browser.
    if is_selected brave; then
        if [[ -n "${MODULE_FAILED[brave]:-}" ]] || ! pkg_installed brave-browser; then
            log_warn "Brave was selected but is not installed; keeping Firefox."
            return 1
        fi
    fi
    if ! pkg_installed firefox; then
        log_info "Firefox is not installed; nothing to remove."
        return 0
    fi
    try sudo dnf remove -y firefox
}

# ---- Category D: Gaming -----------------------------------------------------

mod_steam() {
    ensure_rpmfusion || return 1
    ensure_dnf_plugins || return 1
    try sudo dnf install -y fedora-workstation-repositories || return 1
    try sudo dnf config-manager setopt rpmfusion-nonfree-steam.enabled=1 || return 1
    try sudo dnf install -y steam
}

mod_prism() {
    flatpak_install org.prismlauncher.PrismLauncher
}

mod_jagex() {
    local dir="${HOME}/.local/bin" target pid i
    target="${dir}/jagex-launcher.AppImage"
    mkdir -p -- "$dir" || return 1

    # -f: fail on HTTP errors, -s/-S: quiet but show errors, -L: follow redirects.
    if ! try curl -fsSL -o "$target" "$JAGEX_URL"; then
        rm -f -- "$target"
        return 1
    fi
    try chmod +x -- "$target" || return 1

    # Briefly launch so the AppImage can register its desktop integration.
    "$target" >/dev/null 2>&1 < /dev/null &
    pid=$!
    sleep 3
    # Ask nicely first (SIGTERM); only force-kill if it ignores us.
    kill -TERM "$pid" 2>/dev/null
    for (( i = 0; i < 5; i++ )); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null
    fi
    wait "$pid" 2>/dev/null
    return 0
}

# ---- Category E: Communication & Media --------------------------------------

mod_discord() {
    ensure_rpmfusion || return 1
    try sudo dnf install -y discord
}

mod_vlc() {
    ensure_rpmfusion || return 1
    try sudo dnf install -y vlc
}

mod_kdenlive() {
    try sudo dnf install -y kdenlive
}

# ---- Category F: Productivity & Creative ------------------------------------

mod_sublime() {
    ensure_dnf_plugins || return 1
    try sudo rpm --import "$SUBLIME_KEY_URL" || return 1
    try sudo dnf config-manager addrepo --from-repofile="$SUBLIME_REPO_URL" --overwrite || return 1
    try sudo dnf install -y sublime-text || return 1
    # Remove KWrite only AFTER Sublime installed, so a failure never leaves
    # the user without a text editor.
    if pkg_installed kwrite; then
        try sudo dnf remove -y kwrite
    fi
}

mod_orca() {
    flatpak_install com.orcaslicer.OrcaSlicer
}

# ---- Category G: Debloat ----------------------------------------------------

mod_debloat() {
    local pkg r
    local -a installed=() roots=()

    # Only pass packages that are actually installed, so one missing package
    # cannot make dnf reject the whole transaction.
    for pkg in "${BLOAT_PKGS[@]}"; do
        if pkg_installed "$pkg"; then
            installed+=("$pkg")
        fi
    done
    if (( ${#installed[@]} > 0 )); then
        try sudo dnf remove -y "${installed[@]}"
    else
        log_info "None of the bloat packages are installed."
    fi

    try sudo dnf autoremove -y

    # Delete leftover per-user data (names matched case-insensitively).
    for r in "${HOME}/.config" "${HOME}/.local/share" "${HOME}/.cache"; do
        if [[ -d "$r" ]]; then
            roots+=("$r")
        fi
    done
    if (( ${#roots[@]} > 0 )); then
        # -mindepth/-maxdepth 1: only direct children; -iname: case-insensitive.
        try find "${roots[@]}" -mindepth 1 -maxdepth 1 \
            \( -iname '*kontact*' -o -iname '*kmail*' -o -iname '*akonadi*' \
               -o -iname '*korganizer*' -o -iname '*elisa*' \
               -o -iname '*kaccounts*' -o -iname '*neochat*' \) \
            -exec rm -rf -- {} +
    fi
    [[ "$STEP_FAILED" -eq 0 ]]
}

# ---- Module runner ----------------------------------------------------------

run_module() {
    local key="$1"
    is_selected "$key" || return 0
    STEP_FAILED=0
    printf '\n'
    log_info "=== ${LABEL[$key]} ==="
    "mod_${key}" || STEP_FAILED=1
    if (( STEP_FAILED )); then
        MODULE_FAILED[$key]=1
        FAILED_MODULES+=("${LABEL[$key]}")
        log_warn "Module FAILED: ${LABEL[$key]}"
    else
        log_success "Module finished: ${LABEL[$key]}"
    fi
}

run_selected() {
    local key
    for key in "${RUN_ORDER[@]}"; do
        run_module "$key"
    done
}

# =============================================================================
# SECTION 6: POST-RUN (summary, reboot flow, self-delete)
# =============================================================================

print_summary() {
    local m
    printf '\n'
    rule_line "="
    log_success "All selected modules have been processed."
    rule_line "="
    if (( ${#FAILED_MODULES[@]} > 0 )); then
        log_warn "The following modules reported failures:"
        for m in "${FAILED_MODULES[@]}"; do
            log_warn "  - ${m}"
        done
    fi
}

# True while any dnf / akmods process exists (scan /proc, no extra tools).
pkg_activity_running() {
    local comm_file name
    for comm_file in /proc/[0-9]*/comm; do
        { read -r name < "$comm_file"; } 2>/dev/null || continue
        case "$name" in
            dnf|dnf5|dnf-3|akmods|akmodsbuild) return 0 ;;
        esac
    done
    return 1
}

# Remove this script. "--" protects against paths beginning with a dash.
self_delete() {
    if [[ -f "$SCRIPT_PATH" ]]; then
        rm -f -- "$SCRIPT_PATH" 2>/dev/null
    fi
}

post_run() {
    local ans
    printf '\nWould you like to restart your system now? [Y/n]: '
    if ! IFS= read -r ans < "$TTY_DEV"; then
        ans="n"
    fi
    ans="$(normalize_input "$ans")"

    # Remove the installer in both branches.
    self_delete

    case "$ans" in
        ""|y|yes|1)
            # The NVIDIA kernel module may still be building in the background.
            while pkg_activity_running; do
                log_warn "dnf/akmods still running (kernel module build?). Waiting..."
                sleep 5
            done
            log_info "Rebooting now..."
            sudo systemctl reboot
            ;;
        *)
            log_info "Please reboot manually when convenient."
            if is_selected nvidia; then
                log_warn "NVIDIA drivers were installed: a reboot is REQUIRED before they work."
            fi
            ;;
    esac
}

# =============================================================================
# SECTION 7: MAIN
# =============================================================================

preflight() {
    if [[ "${EUID}" -eq 0 ]]; then
        printf '%s[ERROR] Do not run this script as root or with sudo. Run it as your normal user; it will ask for sudo when needed.%s\n' "$C_RED" "$C_RESET" >&2
        exit 1
    fi
    # Verify the controlling terminal is actually usable.
    if ! { : < "$TTY_DEV"; } 2>/dev/null; then
        printf '%s[ERROR] No controlling terminal available (%s).%s\n' "$C_RED" "$TTY_DEV" "$C_RESET" >&2
        exit 1
    fi
    if ! command -v sudo >/dev/null 2>&1; then
        printf '%s[ERROR] sudo is required but not installed.%s\n' "$C_RED" "$C_RESET" >&2
        exit 1
    fi
}

main() {
    preflight
    menu_loop
    acquire_sudo
    run_selected
    print_summary
    post_run
}

main "$@"
exit "$?"
