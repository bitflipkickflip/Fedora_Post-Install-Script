# --- RPM Fusion (lazy, idempotent) ---
ensure_rpmfusion() {
    if [ "$RPMFUSION_CONFIGURED" = "true" ]; then
        return 0
    fi
    log_info "Configuring RPM Fusion repositories (Fedora ${FEDORA_VERSION})..."
    local free_rpm="https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA_VERSION}.noarch.rpm"
    local nonfree_rpm="https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA_VERSION}.noarch.rpm"
    # dnf install of an already-installed RPM is a no-op (idempotent)
    if ! sudo dnf install -y "$free_rpm" "$nonfree_rpm"; then
        log_warning "RPM Fusion installation failed."
        return 1
    fi
    RPMFUSION_CONFIGURED=true
    log_success "RPM Fusion configured."
}

# --- Flatpak + Flathub (idempotent, shared by Prism & OrcaSlicer) ---
ensure_flatpak_flathub() {
    if ! command -v flatpak &>/dev/null; then
        log_info "Installing Flatpak..."
        sudo dnf install -y flatpak || return 1
    fi
    # --if-not-exists makes this idempotent on re-runs
    flatpak remote-add --if-not-exists flathub "$FLATHUB_REMOTE_URL" || return 1
}

# --- 14. Remove KDE Bloat (runs first among package modules) ---
module_bloat() {
    local bloat_packages=(
        kontact kmail korganizer akregator kaddressbook kcontacts
        kaccounts-integration kaccounts-providers akonadi-server
        akonadi-contacts akonadi-calendar kdepim-addons akonadiconsole
        itinerary elisa-player dragon kamoso kate khelpcenter
        kfind konqueror neochat kpatience kmines ksudoku
        kinfocenter kpat kmahjongg
    )
    log_info "Removing KDE bloat packages..."

    # Build a list of packages that are actually installed
    local to_remove=()
    local pkg
    for pkg in "${bloat_packages[@]}"; do
        if rpm -q "$pkg" &>/dev/null; then
            to_remove+=("$pkg")
        fi
    done

    if [ ${#to_remove[@]} -gt 0 ]; then
        sudo dnf remove -y "${to_remove[@]}" || return 1
    else
        log_info "No bloat packages found installed; skipping."
    fi

    # Autoremove orphans
    sudo dnf autoremove -y || return 1

    # Remove leftover per-user config/data/cache entries (case-insensitive match)
    local pattern
    for pattern in kontact kmail akonadi korganizer elisa kaccounts neochat; do
        local dir
        for dir in "${HOME}/.config" "${HOME}/.local/share" "${HOME}/.cache"; do
            # -I: case-insensitive match; -r: recursive (but we use find for safety)
            local matches
            matches="$(find "$dir" -maxdepth 1 -iname "${pattern}*" 2>/dev/null)" || continue
            if [ -n "$matches" ]; then
                # shellcheck disable=SC2086
                rm -rf -- $matches 2>/dev/null || true
            fi
        done
    done
    log_success "KDE bloat removal complete."
}

# --- 4. Install Brave ---
module_brave() {
    log_info "Setting up Brave browser repository..."
    # Ensure dnf can manage repositories (config-manager plugin)
    # On dnf5 (Fedora 41+), config-manager ships with the base dnf package;
    # we install the plugin package explicitly to satisfy the requirement.
    sudo dnf install -y dnf5 2>/dev/null || true

    # Download the official Brave .repo file and place it in the system repo dir
    local repo_file="/tmp/brave-browser.repo"
    if ! curl -fsSL -o "$repo_file" "$BRAVE_REPO_URL"; then
        log_warning "Could not download Brave .repo file."
        return 1
    fi
    sudo cp -f "$repo_file" /etc/yum.repos.d/brave-browser.repo
    rm -f "$repo_file"

    log_info "Installing Brave..."
    if ! sudo dnf install -y brave-browser; then
        log_warning "Brave installation failed."
        return 1
    fi
    log_success "Brave installed."
}

# --- 5. Remove Firefox ---
module_firefox() {
    log_info "Removing Firefox..."
    # Only proceed if Firefox is actually installed
    if rpm -q firefox &>/dev/null; then
        sudo dnf remove -y firefox || return 1
    else
        log_info "Firefox not installed; skipping."
    fi
    log_success "Firefox removal complete."
}

# --- 3. Install NVIDIA Drivers ---
module_nvidia() {
    ensure_rpmfusion || return 1
    log_info "Installing NVIDIA kernel module and CUDA userspace driver..."
    # kernel-modules-nvidia: pre-built kernel module for the current kernel
    # cuda: CUDA userspace driver and runtime
    sudo dnf install -y kernel-modules-nvidia cuda || return 1
    log_success "NVIDIA drivers installed."
}

# --- 6. Install Steam ---
module_steam() {
    ensure_rpmfusion || return 1
    log_info "Installing Steam..."
    # Install Fedora third-party workstation repositories package
    sudo dnf install -y fedora-workstation-repositories || {
        log_warning "Could not install workstation repositories (continuing)."
    }
    # Enable the RPM Fusion nonfree repo (contains Steam)
    sudo dnf config-manager --set-enabled=true rpmfusion-nonfree 2>/dev/null || true
    sudo dnf install -y steam || return 1
    log_success "Steam installed."
}

# --- 7. Install Prism Launcher ---
module_prism() {
    log_info "Installing Prism Launcher (Flatpak)..."
    ensure_flatpak_flathub || return 1
    sudo flatpak install -y --system flathub org.prismlauncher.PrismLauncher || return 1
    log_success "Prism Launcher installed."
}

# --- 8. Install Jagex Launcher ---
module_jagex() {
    log_info "Installing Jagex Launcher (AppImage)..."
    mkdir -p "$(dirname "$JAGEX_PATH")"
    if ! curl -fsSL -o "$JAGEX_PATH" "$JAGEX_URL"; then
        log_warning "Could not download Jagex Launcher AppImage."
        return 1
    fi
    chmod +x "$JAGEX_PATH"

    # Launch briefly in the background so it can register desktop integration
    # (desktop file, icons, MIME types), then terminate gracefully.
    "$JAGEX_PATH" > /dev/null 2>&1 &
    local launcher_pid=$!
    sleep 3
    # Only signal if the process is still alive (it may have exited on its own)
    if kill -0 "$launcher_pid" 2>/dev/null; then
        kill -TERM "$launcher_pid" 2>/dev/null || true
    fi
    # Reap the child; suppress error if it already exited
    wait "$launcher_pid" 2>/dev/null || true
    log_success "Jagex Launcher installed."
}

