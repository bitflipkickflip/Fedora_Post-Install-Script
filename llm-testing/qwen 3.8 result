# --- 12. Replace KWrite with Sublime Text ---
module_sublime() {
    log_info "Installing Sublime Text (replacing KWrite)..."
    # Remove KWrite first
    if rpm -q kwrite &>/dev/null; then
        sudo dnf remove -y kwrite || log_warning "KWrite removal had issues (continuing)."
    fi
    # Import Sublime HQ GPG signing key
    sudo rpm --import "$SUBRIME_KEY_URL" || return 1
    # Add the Sublime Text stable x86_64 repository
    local repo_file="/tmp/sublime-text.repo"
    if ! curl -fsSL -o "$repo_file" "$SUBRIME_REPO_URL"; then
        log_warning "Could not download Sublime Text .repo file."
        return 1
    fi
    sudo cp -f "$repo_file" /etc/yum.repos.d/sublime-text.repo
    rm -f "$repo_file"
    # Install Sublime Text
    sudo dnf install -y sublime-text || return 1
    log_success "Sublime Text installed."
}

# --- 13. Install OrcaSlicer ---
module_orca() {
    log_info "Installing OrcaSlicer (Flatpak)..."
    ensure_flatpak_flathub || return 1
    sudo flatpak install -y --system flathub com.orcaslicer.OrcaSlicer || return 1
    log_success "OrcaSlicer installed."
}

# --- 1. Wallpaper Setup (runs after all package modules) ---
module_wallpaper() {
    local wp_val="${MODULE_STATE[wallpaper]}"
    if [ "$wp_val" = "3" ]; then
        log_info "Wallpaper module set to Skip; applying non-floating panels only."
    else
        log_info "Setting up wallpaper..."
        mkdir -p "$WALLPAPER_DIR"
        local filename=""
        local url=""
        case "$wp_val" in
            1)
                filename="$WALLPAPER_STANDARD"
                url="${GITHUB_BASE}/${WALLPAPER_STANDARD}"
                ;;
            2)
                filename="$WALLPAPER_ULTRAWIDE"
                url="${GITHUB_BASE}/${WALLPAPER_ULTRAWIDE}"
                ;;
        esac

        local dest="${WALLPAPER_DIR}/${filename}"
        if ! curl -fsSL -o "$dest" "$url"; then
            log_warning "Could not download wallpaper from $url"
            return 1
        fi
        log_success "Wallpaper downloaded to ${dest}"

        local file_url="file://${dest}"

        # Apply desktop wallpaper on all desktops via D-Bus scripting of plasmashell
        # qdbus6 is the Qt6 D-Bus command-line tool (Plasma 6)
        qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
            var img = '${file_url}';
            for (var i = 0; i < desktops.length; ++i) {
                desktops[i].configureWallpaper('org.kde.image', { 'ImagePath': img });
            }
        " > /dev/null 2>&1 || log_warning "D-Bus wallpaper set may have failed."

        # Apply lock screen wallpaper via KDE 6 config tooling
        kwriteconfig6 --file ksolrncrc --group General --key Wallpaper "$file_url" \
            > /dev/null 2>&1 || log_warning "Lock screen wallpaper set may have failed."
    fi

    # Set both default panels to non-floating via D-Bus scripting
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var panels = panelManager.panels();
        for (var i = 0; i < panels.length; ++i) {
            panels[i].floating = false;
            panels[i].saveConfiguration();
        }
    " > /dev/null 2>&1 || log_warning "Panel floating setting may have failed."

    # Restart plasmashell so all changes appear immediately.
    # The D-Bus restart method is asynchronous: the call returns immediately,
    # and plasmashell restarts under the KDE session manager (not tied to our
    # script's process tree). Output is suppressed.
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.restart > /dev/null 2>&1 || true
    sleep 2
    log_success "Wallpaper module complete."
}

# --- 2. System Upgrade (runs last among package modules) ---
module_upgrade() {
    log_info "Running system upgrade..."
    # --refresh: force metadata refresh
    sudo dnf upgrade -y --refresh || return 1
    # Remove orphaned dependencies
    sudo dnf autoremove -y || return 1
    log_success "System upgrade complete."
}

# ─────────────────────────────────────────────
# SECTION: Execution Engine
# ─────────────────────────────────────────────

run_module() {
    # $1 = module key
    local key="$1"
    # Dispatch to the appropriate function
    case "$key" in
        wallpaper) module_wallpaper ;;
        upgrade)   module_upgrade ;;
        nvidia)    module_nvidia ;;
        brave)     module_brave ;;
        firefox)   module_firefox ;;
        steam)     module_steam ;;
        prism)     module_prism ;;
        jagex)     module_jagex ;;
        discord)   module_discord ;;
        vlc)       module_vlc ;;
        kdenlive)  module_kdenlive ;;
        sublime)   module_sublime ;;
        orca)      module_orca ;;
        bloat)     module_bloat ;;
    esac
    # If the function returned non-zero, record the failure
    if [ $? -ne 0 ]; then
        FAILED_MODULES["$key"]=1
        log_warning "Module '${MODULE_LABEL[$key]}' completed with errors."
    fi
}

execute_selected_modules() {
    local key
    local brave_failed=false
    local brave_selected=false
    local firefox_selected=false

    # Determine if Brave and Firefox are selected
    if [ "${MODULE_STATE[brave]}" = "on" ]; then
        brave_selected=true
    fi
    if [ "${MODULE_STATE[firefox]}" = "on" ]; then
        firefox_selected=true
    fi

    echo
    echo "==============================================================="
    echo "  EXECUTING SELECTED MODULES"
    echo "==============================================================="
    echo

    # --- 1. Debloat (first among package-affecting modules) ---
    if [ "${MODULE_STATE[bloat]}" = "on" ]; then
        run_module "bloat"
    fi

    # --- 2. Browsers: Brave before Firefox ---
    if [ "$brave_selected" = true ]; then
        run_module "brave"
        # Check if brave module failed
        if [ -n "${FAILED_MODULES[brave]:-}" ]; then
            brave_failed=true
        fi
    fi
    if [ "$firefox_selected" = true ]; then
        # Do not remove Firefox if Brave was selected AND failed
        if [ "$brave_selected" = true ] && [ "$brave_failed" = true ]; then
            log_info "Brave install failed; skipping Firefox removal to preserve a browser."
        else
            run_module "firefox"
        fi
    fi

    # --- 3. NVIDIA ---
    if [ "${MODULE_STATE[nvidia]}" = "on" ]; then
        run_module "nvidia"
    fi

    # --- 4. Gaming ---
    if [ "${MODULE_STATE[steam]}" = "on" ]; then
        run_module "steam"
    fi
    if [ "${MODULE_STATE[prism]}" = "on" ]; then
        run_module "prism"
    fi
    if [ "${MODULE_STATE[jagex]}" = "on" ]; then
        run_module "jagex"
    fi

    # --- 5. Communication / Media / Productivity ---
    if [ "${MODULE_STATE[discord]}" = "on" ]; then
        run_module "discord"
    fi
    if [ "${MODULE_STATE[vlc]}" = "on" ]; then
        run_module "vlc"
    fi
    if [ "${MODULE_STATE[kdenlive]}" = "on" ]; then
        run_module "kdenlive"
    fi
    if [ "${MODULE_STATE[sublime]}" = "on" ]; then
        run_module "sublime"
    fi
    if [ "${MODULE_STATE[orca]}" = "on" ]; then
        run_module "orca"
    fi

    # --- 6. Wallpaper (after all package modules) ---
    if [ "${MODULE_STATE[wallpaper]}" != "3" ] || [ "${MODULE_STATE[wallpaper]}" = "1" ]; then
        # Always run wallpaper module if value is 1 or 2 (not 3 = Skip)
        if [ "${MODULE_STATE[wallpaper]}" = "1" ] || [ "${MODULE_STATE[wallpaper]}" = "2" ]; then
            run_module "wallpaper"
        elif [ "${MODULE_STATE[wallpaper]}" = "3" ]; then
            # Even when skipping download, apply non-floating panels
            run_module "wallpaper"
        fi
    fi

    # --- 7. System Upgrade (last package-affecting module) ---
    if [ "${MODULE_STATE[upgrade]}" = "on" ]; then
        run_module "upgrade"
    fi
}

# ─────────────────────────────────────────────
# SECTION: Failure Summary
# ─────────────────────────────────────────────

print_failure_summary() {
    if [ ${#FAILED_MODULES[@]} -eq 0 ]; then
        return 0
    fi
    echo
    echo "==============================================================="
    log_warning "The following modules completed with errors:"
    local key
    for key in "${!FAILED_MODULES[@]}"; do
        printf "  - %s\n" "${MODULE_LABEL[$key]}"
    done
    echo "==============================================================="
}

# ─────────────────────────────────────────────
# SECTION: Reboot & Cleanup
# ─────────────────────────────────────────────

wait_for_package_managers() {
    # Wait until no dnf or akmods process is still running
    # (NVIDIA kernel module may still be building in the background)
    local waited=0
    while pgrep -x dnf &>/dev/null || pgrep -x akmods &>/dev/null; do
        log_warning "Waiting for dnf/akmods to finish... (${waited}s)"
        sleep 5
        waited=$(( waited + 5 ))
    done
    if [ "$waited" -gt 0 ]; then
        log_info "Package managers finished after ${waited}s."
    fi
}

self_delete() {
    # Delete the script file from the current directory.
    # Use -- to handle a leading dash in the path safely.
    # Resolve to an absolute path first for safety.
    local script_abs
    script_abs="$(cd "$(dirname -- "$SCRIPT_PATH")" 2>/dev/null && pwd)/$(basename -- "$SCRIPT_PATH")"
    # Fallback: if the resolved path still points to a file, remove it
    if [ -f "$script_abs" ]; then
        rm -f -- "$script_abs" 2>/dev/null || true
    else
        # Final fallback: the script was downloaded as postinstall.sh in CWD
        rm -f -- "./${SCRIPT_NAME}" 2>/dev/null || true
    fi
}

reboot_prompt() {
    local answer=""
    echo
    echo "==============================================================="
    echo "${BOLD}${GREEN}  POST-INSTALLATION COMPLETE${RESET}"
    echo "==============================================================="
    echo

    print_failure_summary

    echo
    # Read from /dev/tty
    read -r -p "Would you like to restart your system now? [Y/n] " answer < /dev/tty || answer=""
    answer="${answer//$'\r'/}"
    answer="${answer#"${answer%%[![:space:]]*}"}"
    answer="${answer%"${answer##*[![:space:]]}"}"
    answer="${answer,,}"

    local do_reboot=false
    case "$answer" in
        ""|y|yes|1) do_reboot=true ;;
    esac

    if [ "$do_reboot" = true ]; then
        wait_for_package_managers
        echo
        log_info "Rebooting now..."
        sudo reboot
    else
        echo
        log_info "Please reboot manually when convenient."
        if [ "${MODULE_STATE[nvidia]}" = "on" ]; then
            log_warning "NVIDIA drivers were installed — a reboot is required for the kernel module to load."
        fi
    fi

    # Self-delete in both branches
    self_delete
}

# ─────────────────────────────────────────────
# SECTION: Main
# ─────────────────────────────────────────────

main() {
    # Refuse to run as root
    if [ "$(id -u)" -eq 0 ]; then
        echo "ERROR: This script must be run as a normal (non-root) user."
        echo "       It configures user-scoped settings in your home directory."
        echo "       Run it with:  bash ${SCRIPT_NAME}"
        exit 1
    fi

    # Basic sanity: verify we have a Fedora system
    if ! grep -q "Fedora" /etc/os-release 2>/dev/null; then
        log_warning "This script is designed for Fedora KDE Plasma 6."
        log_warning "Detected OS: $(. /etc/os-release; echo "${NAME:-unknown}")"
        echo "Press Enter to continue or Ctrl+C to abort..."
        read -r -p "" _ < /dev/tty || exit 0
    fi

    log_info "Fedora version: ${FEDORA_VERSION}"
    log_info "User: ${USER}  Home: ${HOME}"
    echo

    # Interactive menu
    menu_loop
    local menu_rc=$?
    if [ "$menu_rc" -ne 0 ]; then
        exit 0
    fi

    # Acquire sudo credential (asked exactly once)
    acquire_sudo || exit 1
    echo

    # Execute selected modules in the correct order
    execute_selected_modules

    # Post-run
    reboot_prompt
}

main

