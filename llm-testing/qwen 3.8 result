# Sudo keep-alive PID (global for trap access)
SUDO_KEEPALIVE_PID=""

# ─────────────────────────────────────────────
# SECTION: Sudo Credential Management
# ─────────────────────────────────────────────

cleanup_sudo() {
    # Kill the background keep-alive process if it is still running
    if [ -n "$SUDO_KEEPALIVE_PID" ]; then
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        SUDO_KEEPALIVE_PID=""
    fi
}

acquire_sudo() {
    log_info "This script will use sudo for system-wide operations."
    log_info "You will be asked for your password once now."
    echo
    # -v validates the credential and caches it without running a command
    sudo -v || { log_warning "Sudo authentication failed."; return 1; }

    # Start a background loop that refreshes the sudo timestamp every 150 s
    # (default sudo timeout is 300 s; we refresh at half that interval)
    (
        while true; do
            # -n: non-interactive, so it never prompts; just refreshes or fails silently
            sudo -n true 2>/dev/null
            sleep 150
        done
    ) &
    SUDO_KEEPALIVE_PID=$!
    # Register cleanup so the helper is never orphaned
    trap cleanup_sudo EXIT
    log_success "Sudo credential acquired and will be kept alive."
}

# ─────────────────────────────────────────────
# SECTION: Menu Rendering
# ─────────────────────────────────────────────

# Return the display string for a module's current status
module_status_text() {
    local key="$1"
    local state="${MODULE_STATE[$key]}"
    if [ "$key" = "wallpaper" ]; then
        case "$state" in
            1) echo "Resolution 2560x1440" ;;
            2) echo "Resolution 3440x1440" ;;
            3|*) echo "Disabled" ;;
        esac
    else
        if [ "$state" = "on" ]; then
            printf "${GREEN}ON${RESET}"
        else
            printf "${RED}OFF${RESET}"
        fi
    fi
}

render_menu() {
    clear
    local title="FEDORA POST-INSTALLATION CONFIGURATOR"
    local banner_width=62
    # Build a centered title surrounded by = characters
    local padding
    padding=$(( (banner_width - ${#title}) / 2 ))
    local left_pad=""
    local right_pad=""
    local i
    for (( i=0; i<padding; i++ )); do left_pad="${left_pad} "; done
    for (( i=0; i<(( (banner_width - ${#title}) - padding )); i++ )); do right_pad="${right_pad} "; done

    echo "=============================================================================="
    echo "${BOLD}${left_pad}${title}${right_pad}${RESET}"
    echo "=============================================================================="
    echo
    # Column header
    printf "  %-4s %-36s  %s\n" "No." "Module / Option" "Current Status"
    printf "  %-4s %-36s  %s\n" "----" "------------------------------------" "----------------"

    local prev_cat=""
    local num=0
    local key
    local cat
    for key in "${MODULE_ORDER[@]}"; do
        num=$(( num + 1 ))
        cat="${MODULE_CATEGORY[$key]}"
        # Print category header when category changes
        if [ "$cat" != "$prev_cat" ]; then
            echo
            printf "  [ %s ]\n" "$cat"
            prev_cat="$cat"
        fi
        local label="${MODULE_LABEL[$key]}"
        local status
        status="$(module_status_text "$key")"
        printf "  %-4d %-36s  %s\n" "$num" "$label" "$status"
    done

    echo
    echo "  Wallpaper values: 1 = 2560x1440  2 = 3440x1440  3 = Skip"
    echo
    echo "  Enter a number to toggle that module."
    echo "  'run' or 'r' to execute selected modules."
    echo "  'quit' or 'q' to abort."
    echo
}

# ─────────────────────────────────────────────
# SECTION: Interactive Menu Loop
# ─────────────────────────────────────────────

menu_loop() {
    local input=""
    local num
    while true; do
        render_menu
        # Read from the controlling terminal, not stdin
        read -r -p "set > " input < /dev/tty || return 0
        # Strip carriage returns (Windows-style line endings)
        input="${input//$'\r'/}"
        # Trim leading and trailing whitespace
        input="${input#"${input%%[![:space:]]*}"}"
        input="${input%"${input##*[![:space:]]}"}"
        # Case-insensitive
        input="${input,,}"

        case "$input" in
            quit|q)
                echo
                log_info "Aborted. No changes made."
                exit 0
                ;;
            run|r)
                return 0
                ;;
            [0-9]*)
                num="$input"
                # Validate: must be a positive integer within range
                if [ "$num" -ge 1 ] && [ "$num" -le "${#MODULE_ORDER[@]}" ] 2>/dev/null; then
                    local idx=$(( num - 1 ))
                    local key="${MODULE_ORDER[$idx]}"
                    if [ "$key" = "wallpaper" ]; then
                        # Sub-prompt for wallpaper multi-choice
                        local wp_input=""
                        echo -n "  Wallpaper (1=2560x1440, 2=3440x1440, 3=Skip) > "
                        read -r -p "" wp_input < /dev/tty || continue
                        wp_input="${wp_input//$'\r'/}"
                        wp_input="${wp_input#"${wp_input%%[![:space:]]*}"}"
                        wp_input="${wp_input%"${wp_input##*[![:space:]]}"}"
                        case "$wp_input" in
                            1|2|3) MODULE_STATE["wallpaper"]="$wp_input" ;;
                            *) : ;;  # silently ignore invalid
                        esac
                    else
                        # Toggle boolean
                        if [ "${MODULE_STATE[$key]}" = "on" ]; then
                            MODULE_STATE["$key"]="off"
                        else
                            MODULE_STATE["$key"]="on"
                        fi
                    fi
                fi
                # Out-of-range or non-numeric: silently ignore, redraw
                ;;
            *)
                # Unrecognized text: silently ignore, redraw
                ;;
        esac
    done
}

